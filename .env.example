# Conexão com o Postgres. No Supabase fica em
# Project Settings → Database → Connection string → URI.
#
# USE A PORTA 6543 (Transaction pooler), não a 5432.
# A 5432 é modo sessão: cada cliente segura uma conexão até encerrar e o
# teto do Supabase é 20 conexões. Como cada instância de serverless function
# abre o próprio pool, o modo sessão esgota em minutos de uso normal e as
# telas passam a subir com "A server error occurred".
#
# O ?sslmode=require pode vir; o código tira e cuida do TLS sozinho.
DATABASE_URL="postgresql://postgres.XXXXXXXXXXXX:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"

# Para um Postgres rodando na sua própria máquina, sem TLS:
# DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/layane"

SESSION_DAYS="30"
